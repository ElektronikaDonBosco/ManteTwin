 {
  "id": "prev_plan",
  "type": "function",
  "name": "Plan de mantenimiento",
  "func": "// PLAN DE MANTENIMIENTO PREVENTIVO (lo decide Node-RED, no el ESP32)\n// Intervalos tipo fabricante. Cambialos aqui para tu motor real.\nconst PLAN = {\n    engrase:     { nombre: 'Engrase',              limite: 250,  unidad: 'h' },\n    rodamientos: { nombre: 'Revision rodamientos', limite: 1000, unidad: 'h' },\n    electrica:   { nombre: 'Revision contactor',   limite: 30,   unidad: 'arranques' }\n};\nconst AVISO = 90;     // % de uso a partir del cual el mantenimiento esta PROXIMO\nconst d = msg.payload;\nif (!d || !d.tareas) return null;\n\nlet peor = 'OK', texto = 'Todo al dia';\nconst gauges = [], detalle = [];\nconst rango = { OK: 0, PROXIMO: 1, VENCIDO: 2, FALLO: 3 };\nfor (const id of Object.keys(PLAN)) {\n    const p = PLAN[id];\n    const uso = d.tareas[id] || 0;\n    const pct = Math.round(uso / p.limite * 1000) / 10;\n    const resta = Math.max(0, p.limite - uso);\n    let est = pct >= 100 ? 'VENCIDO' : (pct >= AVISO ? 'PROXIMO' : 'OK');\n    gauges.push({ payload: Math.min(pct, 120) });\n    detalle.push({ payload: est === 'VENCIDO'\n        ? `${p.nombre}: VENCIDO (+${(uso - p.limite).toFixed(p.unidad === 'h' ? 1 : 0)} ${p.unidad})`\n        : `${p.nombre}: faltan ${resta.toFixed(p.unidad === 'h' ? 1 : 0)} ${p.unidad}` });\n    if (rango[est] > rango[peor]) { peor = est; texto = `${p.nombre} ${est === 'VENCIDO' ? 'vencido' : 'proximo'}`; }\n}\n\n// El tacometro manda sobre el plan: un motor bloqueado es una AVERIA\nif (d.fallo) { peor = 'FALLO'; texto = 'Motor bloqueado: revisar'; }\n\n// Solo avisamos al ESP32 (y al operario) cuando cambia el estado\nconst egoera = `${peor};${texto}`;\nlet aviso = null, log = null;\nif (context.get('ultimo') !== egoera) {\n    context.set('ultimo', egoera);\n    if (peor !== 'OK') aviso = { payload: `MOTOR1: ${texto}`, topic: peor };\n    log = { payload: `${new Date().toISOString()};AVISO;${peor};${texto};${d.h.toFixed(2)};${d.arranques}` };\n    msg = { payload: egoera };\n} else msg = null;\n\nnode.status({ fill: peor === 'OK' ? 'green' : (peor === 'PROXIMO' ? 'yellow' : 'red'),\n              shape: 'dot', text: `${d.h.toFixed(1)} h, ${d.arranques} arr. - ${peor}` });\n\nreturn [msg, gauges[0], gauges[1], gauges[2], detalle[0], detalle[1], detalle[2],\n        { payload: `${d.h.toFixed(1)} h` }, { payload: String(d.arranques) },\n        { payload: d.fallo ? 'BLOQUEADO' : (d.on ? 'EN MARCHA' : 'PARADO') }, aviso, log,\n        { payload: d.rpm || 0 }, { payload: String(d.bloqueos || 0) }];\n",
  "outputs": 14,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 540,
  "y": 300,
