  {
    "id": "d_split_v3",
    "type": "function",
    "z": "mt_tab_dash3",
    "x": 400,
    "y": 120,
    "name": "Repartir",
    "func": "const a = msg.payload;\nconst fmt = m => m === null ? '—' : m < 1 ? Math.round(m * 60) + ' s' : m.toFixed(1) + ' min';\nconst labels = {OK: '🟢 OK', TREND: '🟡 Tendencia de deriva', WARN: '🟠 Aviso', ALARM: '🔴 ALARMA – recalibrar'};\nreturn [\n  [ {topic: 'dT_ema', payload: a.dT_ema},\n    {topic: 'Aviso 0,5 °C', payload: 0.5},\n    {topic: 'Alarma 1,5 °C', payload: 1.5} ],\n  {payload: a.health_pct},\n  {payload: fmt(a.rul_min)},\n  {payload: labels[a.state_server] || a.state_server},\n  {payload: (a.slope_c_min * 60).toFixed(2) + ' °C/h  (R² ' + a.r2 + ')'},\n  {payload: a.state_edge + (a.label ? '  · fallo inyectado' : '')}\n];",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
