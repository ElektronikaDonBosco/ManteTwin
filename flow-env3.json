  {
    "id": "env3_tab",
    "type": "tab",
    "label": "ENV III (Wokwi)",
    "disabled": false,
    "info": "Recibe la telemetría del ESP32 simulado y controla el LED."
  },
  {
    "id": "env3_c1",
    "type": "comment",
    "z": "env3_tab",
    "name": "1 · Datos del ESP32 (cada 5 s)",
    "info": "",
    "x": 160,
    "y": 40,
    "wires": []
  },
  {
    "id": "env3_in",
    "type": "mqtt in",
    "z": "env3_tab",
    "name": "telemetry",
    "topic": "mantetwin/env3/telemetry",
    "qos": "1",
    "datatype": "json",
    "broker": "env3_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 120,
    "y": 100,
    "wires": [
      [
        "env3_dbg",
        "env3_fmt"
      ]
    ]
  },
  {
    "id": "env3_dbg",
    "type": "debug",
    "z": "env3_tab",
    "name": "ENV III",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 340,
    "y": 80,
    "wires": []
  },
  {
    "id": "env3_fmt",
    "type": "function",
    "z": "env3_tab",
    "name": "Mostrar valores",
    "func": "const d = msg.payload;\nnode.status({fill: 'green', shape: 'dot', text: `${d.t} °C · ${d.h} % · ${d.p ?? '—'} hPa · LED ${d.led ? 'ON' : 'OFF'}`});\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 130,
    "wires": [
      []
    ]
  },
  {
    "id": "env3_c2",
    "type": "comment",
    "z": "env3_tab",
    "name": "2 · Estado de conexión (LWT)",
    "info": "",
    "x": 160,
    "y": 190,
    "wires": []
  },
  {
    "id": "env3_st",
    "type": "mqtt in",
    "z": "env3_tab",
    "name": "status",
    "topic": "mantetwin/env3/status",
    "qos": "1",
    "datatype": "utf8",
    "broker": "env3_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 110,
    "y": 240,
    "wires": [
      [
        "env3_st_fn"
      ]
    ]
  },
  {
    "id": "env3_st_fn",
    "type": "function",
    "z": "env3_tab",
    "name": "online / offline",
    "func": "node.status({fill: msg.payload === 'online' ? 'green' : 'red', shape: 'dot', text: msg.payload});\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 240,
    "wires": [
      [
        "env3_st_dbg"
      ]
    ]
  },
