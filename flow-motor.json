  {
    "id": "motor1_fn_analisia",
    "type": "function",
    "z": "motor1_tab_mantetwin",
    "name": "Analisia (oinarria + mugak)",
    "func": "// Oinarria ikasi (motorra egoera onean) eta mugak kalkulatu\nconst IKASTEKO_N = 30;          // 30 leiho = ~30 s\nconst K_ABISUA = 3, K_ALARMA = 6;\nconst SD_MIN = 0.01;            // g, sigma txikiegia saihesteko\n\nif (msg.topic === 'relearn') {\n    context.set('b', { n: 0, mean: 0, m2: 0, ready: false });\n    context.set('hist', []);\n    context.set('state', null);\n    node.status({ fill: 'blue', shape: 'ring', text: 'Oinarria berrikasten...' });\n    return [null, null, { payload: 'IKASTEN - oinarria berrikasten' },\n            { payload: 'IKASTEN' }, { payload: 'Oinarria berrikasten hasi da' }, null];\n}\n\nconst d = msg.payload;\nif (!d || typeof d.rms !== 'number') return null;\nconst rms = d.rms;\nconst peak = Number(d.peak || 0), crest = Number(d.crest || 0), temp = Number(d.temp || 0);\n\n// Batez besteko mugikorra (azken 5 leihoak) zarata leuntzeko\nconst hist = context.get('hist') || [];\nhist.push(rms);\nif (hist.length > 5) hist.shift();\ncontext.set('hist', hist);\nconst avg = hist.reduce((s, v) => s + v, 0) / hist.length;\n\nconst b = context.get('b') || { n: 0, mean: 0, m2: 0, ready: false };\nlet state = 'IKASTEN', warn = null, alarm = null;\n\nif (!b.ready) {\n    // Welford algoritmoa: batez bestekoa eta bariantza online\n    b.n++;\n    const delta = rms - b.mean;\n    b.mean += delta / b.n;\n    b.m2 += delta * (rms - b.mean);\n    if (b.n >= IKASTEKO_N) b.ready = true;\n    context.set('b', b);\n}\nif (b.ready) {\n    const sd = Math.max(Math.sqrt(b.m2 / (b.n - 1)), SD_MIN);\n    warn = b.mean + K_ABISUA * sd;\n    alarm = b.mean + K_ALARMA * sd;\n    state = avg >= alarm ? 'ALARMA' : (avg >= warn ? 'ABISUA' : 'NORMALA');\n}\n\nconst colors = { IKASTEN: 'blue', NORMALA: 'green', ABISUA: 'yellow', ALARMA: 'red' };\nnode.status({ fill: colors[state], shape: 'dot', text: `${state} - RMS ${avg.toFixed(3)} g` });\n\n// 1) gauge  2) grafikoa  3) testua  4) ESP32-ra  5) jakinarazpena  6) CSV loga\nconst chart = [{ topic: 'RMS', payload: rms }, { topic: 'Batez bestekoa', payload: avg }];\nif (b.ready) chart.push({ topic: 'Abisu-muga', payload: warn }, { topic: 'Alarma-muga', payload: alarm });\n\nconst text = {\n    payload: b.ready\n        ? `${state} | RMS ${rms.toFixed(3)} g | gailurra ${peak.toFixed(3)} g | crest ${crest.toFixed(2)} | ${temp.toFixed(1)} C`\n        : `IKASTEN ${b.n}/${IKASTEKO_N} (motorra egoera onean egon behar da)`\n};\n\nlet toEsp = null, notif = null, log = null;\nif (state !== context.get('state')) {\n    context.set('state', state);\n    toEsp = { payload: state };\n    if (state !== 'IKASTEN') {\n        notif = { payload: `Motor1: ${state} (RMS ${avg.toFixed(3)} g; mugak ${warn.toFixed(3)} / ${alarm.toFixed(3)} g)` };\n    }\n    log = { payload: [new Date().toISOString(), state, rms.toFixed(4), avg.toFixed(4),\n                      warn === null ? '' : warn.toFixed(4), alarm === null ? '' : alarm.toFixed(4)].join(';') };\n}\nreturn [{ payload: rms }, chart, text, toEsp, notif, log];\n",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "outputLabels": [
      "RMS",
      "Grafikoa",
      "Testua",
      "ESP32-ra",
      "Jakinarazpena",
      "CSV"
    ],
