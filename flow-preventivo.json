 {
  "id": "prev_libro",
  "type": "function",
  "name": "Registrar mantenimiento",
  "func": "// Boton \"Hecho\": registra el mantenimiento en el libro (CSV) y avisa al ESP32\nconst ultimo = flow.get('ultimoDato') || { h: 0, arranques: 0 };\nconst fecha = new Date().toISOString();\nreturn [\n    { payload: msg.payload },                                          // -> cmd ESP32\n    { payload: `${fecha};HECHO;${msg.topic};;${ultimo.h.toFixed(2)};${ultimo.arranques}` },  // -> CSV\n    { payload: `Registrado: ${msg.topic} (${ultimo.h.toFixed(1)} h)` } // -> notificacion\n];\n",
  "outputs": 3,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 400,
  "y": 600,
  "wires": [
   [
    "prev_out_cmd"
   ],
   [
    "prev_csv"
   ],
   [
    "prev_notif"
   ]
  ],
  "z": "prev_tab"
 },
