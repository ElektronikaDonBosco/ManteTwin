  {
    "id": "fn_sim",
    "type": "function",
    "z": "mt_tab_drift",
    "x": 390,
    "y": 660,
    "name": "Simulador mt-drift",
    "func": "// Simulador de telemetría (para probar el flujo sin Wokwi)\n// flow.sim_rate = deriva en °C/min (0 = sin deriva)\nconst rate = flow.get(\"sim_rate\") || 0;\nif (flow.get(\"sim_on\") !== true) return null;\nlet s = context.get(\"s\") || { seq: 0, off: 0, ema: 0 };\ns.seq++;\ns.off += rate * (2 / 60);                     // muestras cada 2 s\nconst tRef = 24 + (Math.random() - 0.5) * 0.1;\nconst t = 24 + s.off + (Math.random() - 0.5) * 0.1;\nconst dT = t - tRef;\ns.ema = 0.9 * s.ema + 0.1 * dT;\ncontext.set(\"s\", s);\nconst st = Math.abs(s.ema) > 1.5 ? \"DRIFT_ALARM\" : Math.abs(s.ema) > 0.5 ? \"DRIFT_WARN\" : \"OK\";\nmsg.payload = { node: \"mt-drift\", scn: 1, seq: s.seq, t: +t.toFixed(2), h: 45, t_ref: +tRef.toFixed(2),\n                dT: +dT.toFixed(3), dT_ema: +s.ema.toFixed(3), st, label: rate > 0 ? 1 : 0 };\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "fn_rul"
      ]
    ]
  },
